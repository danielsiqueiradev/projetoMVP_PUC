import os
import time
import pandas as pd
import requests
from dotenv import load_dotenv
from googleapiclient.discovery import build
from googleapiclient.errors import HttpError
from transformers import pipeline

load_dotenv()

# Setup das APIs
try:
    youtube = build('youtube', 'v3', developerKey=os.getenv("YOUTUBE_API_KEY"))
    analisador = pipeline("sentiment-analysis", model="nlptown/bert-base-multilingual-uncased-sentiment")
except Exception as e:
    print("Aviso: Falha ao carregar o modelo ou a API do YouTube. Verifique sua chave.")

OMDB_KEY = os.getenv("OMDB_API_KEY")

def get_omdb_rating(titulo):
    try:
        url = f"http://www.omdbapi.com/?t={titulo}&apikey={OMDB_KEY}"
        res = requests.get(url)
        if res.status_code in [401, 429]: raise Exception("API_LIMIT_OMDB")
        data = res.json()
        for r in data.get('Ratings', []):
            if r['Source'] == 'Rotten Tomatoes': return float(r['Value'].replace('%', ''))
        return 0.0
    except: return 0.0

def get_youtube_data(titulo):
    try:
        search = youtube.search().list(q=f"{titulo} trailer oficial", part='id', type='video', maxResults=1).execute()
        if not search['items']: return 0.0, 0.0, 0.0
        
        v_id = search['items'][0]['id']['videoId']
        stats = youtube.videos().list(part='statistics', id=v_id).execute()['items'][0]['statistics']
        v = float(stats.get('viewCount', 0))
        l = float(stats.get('likeCount', 0))
        
        coments = youtube.commentThreads().list(part='snippet', videoId=v_id, maxResults=5).execute()
        textos = [c['snippet']['topLevelComment']['snippet']['textDisplay'] for c in coments['items']]
        notas = [float(analisador(t)[0]['label'].split()[0]) for t in textos]
        s = sum(notas) / len(notas) if notas else 0.0
        return v, l, s
    except HttpError as e:
        if e.resp.status in [403, 429]: raise Exception("API_LIMIT_YOUTUBE")
        return 0.0, 0.0, 0.0
    except: return 0.0, 0.0, 0.0

def fiscal_de_planilha_definitivo():
    arquivo = "Base_Kinoplex_ML_Final_Patched.csv"
    df = pd.read_csv(arquivo)
    filmes_unicos = df['TITULO_ORIGINAL'].unique()
    
    print("🔍 FASE 1: Vasculhando a base pra ver o que já temos salvo...")
    dicionario_dados = {}
    filmes_para_baixar = []
    
    # Olha filme por filme
    for titulo in filmes_unicos:
        # Pega todas as linhas desse filme
        subset = df[df['TITULO_ORIGINAL'] == titulo]
        max_views = subset['yt_views'].max()
        
        if max_views > 0:
            # Se a view máxima for maior que 0, significa que temos o dado!
            # Pega a primeira linha que tem o dado certinho e guarda
            linha_boa = subset[subset['yt_views'] > 0].iloc[0]
            dicionario_dados[titulo] = {
                'rt': linha_boa['rotten_tomatoes'],
                'views': linha_boa['yt_views'],
                'likes': linha_boa['yt_likes'],
                'sent': linha_boa['yt_sentiment']
            }
        else:
            # Tá zerado, vai pra fila de download
            filmes_para_baixar.append(titulo)
            
    print(f"✅ Já temos os dados perfeitos para {len(dicionario_dados)} filmes.")
    print(f"⚠️ Precisamos baixar dados APENAS para {len(filmes_para_baixar)} filmes.")
    
    print("\n🌐 FASE 2: Iniciando download (Respeitando a API)...")
    limite_atingido = False
    for i, titulo in enumerate(filmes_para_baixar):
        print(f"[{i+1}/{len(filmes_para_baixar)}] Baixando: {titulo}")
        try:
            rt = get_omdb_rating(titulo)
            v, l, s = get_youtube_data(titulo)
            
            # Adiciona os dados novos na memória
            dicionario_dados[titulo] = {'rt': rt, 'views': v, 'likes': l, 'sent': s}
            time.sleep(1.0) # Respiro pro Google não bloquear
            
        except Exception as e:
            erro = str(e)
            if "API_LIMIT" in erro:
                print(f"\n❌ CAÔ! A cota do Google esgotou: {erro}")
                limite_atingido = True
                break # Puxa o freio de mão imediatamente
            else:
                dicionario_dados[titulo] = {'rt': 0.0, 'views': 0.0, 'likes': 0.0, 'sent': 0.0}

    print("\n🚀 FASE 3: Imputando os valores em todas as 45 mil linhas...")
    
    # Preenche quem ficou sem baixar por causa do limite com zero pra não dar erro
    for titulo in filmes_unicos:
        if titulo not in dicionario_dados:
            dicionario_dados[titulo] = {'rt': 0.0, 'views': 0.0, 'likes': 0.0, 'sent': 0.0}
            
    # Aplica o dicionário em massa na planilha
    df['rotten_tomatoes'] = df['TITULO_ORIGINAL'].map(lambda x: dicionario_dados[x]['rt'])
    df['yt_views'] = df['TITULO_ORIGINAL'].map(lambda x: dicionario_dados[x]['views'])
    df['yt_likes'] = df['TITULO_ORIGINAL'].map(lambda x: dicionario_dados[x]['likes'])
    df['yt_sentiment'] = df['TITULO_ORIGINAL'].map(lambda x: dicionario_dados[x]['sent'])
    
    df.to_csv(arquivo, index=False)
    
    if limite_atingido:
        print("⚠️ Salvo! Ele parou porque a chave esgotou, mas guardou tudo que já tinha e o que conseguiu baixar hoje.")
    else:
        print("✅ VRAU! Trabalho finalizado. Base preenchida 100%.")

if __name__ == "__main__":
    fiscal_de_planilha_definitivo()